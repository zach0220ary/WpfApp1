<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="week02" Height="450" Width="800" Background="#FFF5EFDB">
    <Grid x:Name="numberTextBox1">
        <Label Content="Hello World" HorizontalAlignment="Left" Margin="28,14,0,0" VerticalAlignment="Top" Width="181" Height="43" RenderTransformOrigin="0.464,0.849"/>
        <Label Content="視窗程式設計很好玩" HorizontalAlignment="Left" Margin="134,17,0,0" VerticalAlignment="Top" Width="214" Height="26"/>
        <Label Content="姓名" HorizontalAlignment="Left" Margin="55,45,0,0" VerticalAlignment="Top" Width="42" Height="35" Foreground="Red"/>
        <TextBox x:Name="nameTexBox" HorizontalAlignment="Left" Margin="100,52,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="151" Height="23"/>
        <Label Content="電話" HorizontalAlignment="Left" Margin="55,75,0,0" VerticalAlignment="Top" Width="40" Height="35" Foreground="Red"/>
        <TextBox x:Name="telTextBox"  HorizontalAlignment="Left" Margin="100,81,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="151" Height="24"/>
        <Button Content="確認" HorizontalAlignment="Left" Margin="282,57,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Height="47" Width="83">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.053"/>
                    <RotateTransform Angle="0.363"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <Label Content="輸入一個數值" HorizontalAlignment="Left" Margin="57,108,0,0" VerticalAlignment="Top" Width="103" Height="36" Foreground="Red"/>
        <TextBox x:Name="numberTextBox"  HorizontalAlignment="Left" Margin="162,115,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="91" RenderTransformOrigin="0.5,0.5" Height="24">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.032"/>
                    <RotateTransform Angle="0.221"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <TextBlock x:Name="resultTextBlock" HorizontalAlignment="Left" Height="220" Margin="-1,145,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="788" Background="#FFF5BDB0"/>
        <Button x:Name="egth" Content="顯示N*N乘法表"  HorizontalAlignment="Left" Margin="275,113,0,0" VerticalAlignment="Top" Height="26" Width="112" Click="egth_Click"/>

    </Grid>
</Window>
